<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<VBox xmlns:fx="http://javafx.com/fxml/1" fx:controller="ru.mirea.blogplatform.fx.form.CommentFormController" spacing="10" prefWidth="630">
    <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
    <Label text="Все поля обязательны" styleClass="muted"/>
    <Label text="Публикация"/><ComboBox fx:id="postBox" promptText="Выберите публикацию" maxWidth="Infinity"/>
    <Label text="Автор комментария"/><ComboBox fx:id="authorBox" promptText="Выберите автора" maxWidth="Infinity"/>
    <Label text="Текст комментария"/><TextArea fx:id="textField" wrapText="true" prefRowCount="6" prefHeight="180" VBox.vgrow="ALWAYS"/>
    <Label fx:id="statusLabel" styleClass="muted"/>
    <Label fx:id="errorLabel" styleClass="error-text" wrapText="true" minHeight="32" maxWidth="600"/>
</VBox>
